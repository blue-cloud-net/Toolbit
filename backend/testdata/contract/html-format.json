{
  "slug": "html-format",
  "description": "HTML 美化 / 压缩 / 校验的契约测试数据。",
  "cases": [
    {
      "name": "美化片段",
      "request": {
        "input": { "data": "<div><p>hello</p></div>" },
        "action": "format",
        "indent": 2
      },
      "expect": {
        "code": 0,
        "dataContains": { "valid": true, "output": "<div>\n  <p>hello</p>\n</div>" }
      }
    },
    {
      "name": "校验合法内容",
      "request": {
        "input": { "data": "<p>x</p>" },
        "action": "validate"
      },
      "expect": {
        "code": 0,
        "dataContains": { "valid": true }
      }
    }
  ]
}
