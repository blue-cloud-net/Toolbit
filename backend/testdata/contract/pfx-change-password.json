{
  "slug": "pfx-change-password",
  "description": "PKCS#12 改密的契约测试数据。",
  "cases": [
    {
      "name": "改用新口令",
      "request": {
        "container": {
          "data": "",
          "format": "der"
        },
        "oldPassphrase": "test-pass",
        "newPassphrase": "new-test-pass"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "encoding": "base64"
        }
      }
    },
    {
      "name": "缺少新口令",
      "request": {
        "container": {
          "data": "",
          "format": "der"
        },
        "oldPassphrase": "test-pass"
      },
      "expect": {
        "code": 400,
        "errorCode": "MISSING_FIELD"
      }
    }
  ]
}
