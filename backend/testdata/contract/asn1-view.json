{
  "slug": "asn1-view",
  "description": "ASN.1 视图的契约测试数据。",
  "cases": [
    {
      "name": "查看证书 DER 结构",
      "request": {
        "input": {
          "data": "",
          "format": "der"
        }
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "tree": {
            "number": 16,
            "constructed": true
          }
        }
      }
    },
    {
      "name": "限制展开深度",
      "request": {
        "input": {
          "data": "",
          "format": "der"
        },
        "maxDepth": 2
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "maxDepth": 2
        }
      }
    },
    {
      "name": "非法 DER",
      "request": {
        "input": {
          "data": "MAM=",
          "format": "base64"
        }
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_DER"
      }
    }
  ]
}
