{
  "slug": "archive-inspect",
  "description": "归档内容查看的契约测试数据。",
  "cases": [
    {
      "name": "查看 ZIP 条目",
      "request": {
        "data": "UEsDBBQAAAAAANQCXl2GphA2BQAAAAUAAAAFAAAAYS50eHRoZWxsb1BLAQIUAxQAAAAAANQCXl2GphA2BQAAAAUAAAAFAAAAAAAAAAAAAACAAQAAAABhLnR4dFBLBQYAAAAAAQABADMAAAAoAAAAAAA=",
        "format": "zip"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "format": "zip",
          "entryCount": 1
        }
      }
    },
    {
      "name": "缺少归档数据",
      "request": {
        "format": "zip"
      },
      "expect": {
        "code": 400,
        "errorCode": "MISSING_FIELD"
      }
    },
    {
      "name": "数据不是合法归档",
      "request": {
        "data": "bm90LWEtcmNoaXZl",
        "format": "zip"
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    }
  ]
}
