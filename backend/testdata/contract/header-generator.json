{
  "slug": "header-generator",
  "description": "请求头生成工具的契约测试数据。",
  "cases": [
    {
      "name": "生成 Chrome 请求头",
      "request": {
        "platform": "chrome",
        "version": "120.0.0.0"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        }
      }
    },
    {
      "name": "生成 curl 请求头",
      "request": {
        "platform": "curl",
        "version": "8.9.1"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "userAgent": "curl/8.9.1"
        }
      }
    },
    {
      "name": "不支持的平台",
      "request": {
        "platform": "netscape"
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    }
  ]
}
