{
  "slug": "p7b-extract",
  "description": "PKCS#7 证书袋提取的契约测试数据。",
  "cases": [
    {
      "name": "提取两张证书",
      "request": {
        "container": {
          "data": "",
          "format": "der"
        }
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "count": 2
        }
      }
    },
    {
      "name": "非法容器",
      "request": {
        "container": {
          "data": "MAM=",
          "format": "base64"
        }
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_PKCS7"
      }
    }
  ]
}
