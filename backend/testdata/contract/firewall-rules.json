{
  "slug": "firewall-rules",
  "description": "防火墙规则生成的契约测试数据。",
  "cases": [
    {
      "name": "生成 ufw 规则",
      "request": {
        "tool": "ufw",
        "scenario": "https",
        "protocol": "tcp"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "tool": "ufw",
          "scenario": "https"
        }
      }
    },
    {
      "name": "生成 iptables 规则",
      "request": {
        "tool": "iptables",
        "scenario": "ssh",
        "protocol": "tcp"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "tool": "iptables"
        }
      }
    },
    {
      "name": "不支持的工具",
      "request": {
        "tool": "pf",
        "scenario": "http"
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    }
  ]
}
