{
  "slug": "mime-lookup",
  "description": "MIME 类型查询的契约测试数据。",
  "cases": [
    {
      "name": "按扩展名查 PNG",
      "request": { "query": "png" },
      "expect": {
        "code": 0,
        "dataContains": { "query": "png", "total": 2 }
      }
    },
    {
      "name": "按文件名查 PDF",
      "request": { "query": "report.pdf" },
      "expect": {
        "code": 0,
        "dataContains": { "query": "pdf", "total": 1 }
      }
    },
    {
      "name": "按媒体类型查 JSON",
      "request": { "query": "application/json" },
      "expect": {
        "code": 0,
        "dataContains": { "query": "application/json", "total": 1 }
      }
    },
    {
      "name": "媒体类型带参数时去掉参数",
      "request": { "query": "text/plain; charset=utf-8" },
      "expect": {
        "code": 0,
        "dataContains": { "query": "text/plain", "total": 1 }
      }
    },
    {
      "name": "历史别名归一到规范类型",
      "request": { "query": "image/x-png" },
      "expect": {
        "code": 0,
        "dataContains": { "query": "image/x-png", "total": 1 }
      }
    },
    {
      "name": "未收录的扩展名",
      "request": { "query": "zzzz" },
      "expect": {
        "code": 0,
        "dataContains": { "query": "zzzz", "total": 0 }
      }
    },
    {
      "name": "空请求返回全量列表",
      "request": {},
      "expect": {
        "code": 0,
        "dataContains": { "query": "", "category": "", "total": 119 }
      }
    },
    {
      "name": "按顶层类型过滤",
      "request": { "category": "image" },
      "expect": {
        "code": 0,
        "dataContains": { "category": "image", "total": 12 }
      }
    },
    {
      "name": "按扩展名关键词检索",
      "request": { "query": "png" },
      "expect": {
        "code": 0,
        "dataContains": { "query": "png", "total": 2 }
      }
    },
    {
      "name": "查询词与顶层类型叠加",
      "request": { "query": "png", "category": "image" },
      "expect": {
        "code": 0,
        "dataContains": { "query": "png", "category": "image", "total": 2 }
      }
    },
    {
      "name": "非法顶层类型",
      "request": { "category": "bogus" },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    }
  ]
}
