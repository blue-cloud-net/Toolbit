{
  "slug": "regex-tester",
  "description": "正则测试的契约测试数据。",
  "cases": [
    {
      "name": "匹配邮箱",
      "request": {
        "pattern": "(\\w+)@(\\w+)\\.com",
        "input": { "data": "mail: alice@example.com" }
      },
      "expect": {
        "code": 0,
        "dataContains": { "count": 1, "truncated": false }
      }
    },
    {
      "name": "忽略大小写标志",
      "request": {
        "pattern": "abc",
        "flags": ["i"],
        "input": { "data": "ABC" }
      },
      "expect": {
        "code": 0,
        "dataContains": { "count": 1 }
      }
    },
    {
      "name": "语法错误",
      "request": {
        "pattern": "a(b",
        "input": { "data": "abc" }
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_REGEX"
      }
    },
    {
      "name": "缺少输入",
      "request": {
        "pattern": "a"
      },
      "expect": {
        "code": 400,
        "errorCode": "MISSING_FIELD"
      }
    },
    {
      "name": "未知标志",
      "request": {
        "pattern": "a",
        "flags": ["z"],
        "input": { "data": "abc" }
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    }
  ]
}
