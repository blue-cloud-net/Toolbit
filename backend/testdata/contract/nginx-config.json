{
  "slug": "nginx-config",
  "description": "Nginx 配置生成的契约测试数据。",
  "cases": [
    {
      "name": "生成站点配置",
      "request": {
        "mode": "site",
        "serverName": "example.com",
        "listenPort": 80,
        "root": "/var/www/html"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "mode": "site"
        }
      }
    },
    {
      "name": "生成全局配置",
      "request": {
        "mode": "global",
        "workerProcesses": 4
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "mode": "global"
        }
      }
    },
    {
      "name": "不支持的模式",
      "request": {
        "mode": "stream"
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    }
  ]
}
