{
  "slug": "password-gen",
  "description": "密码生成的契约测试数据。",
  "cases": [
    {
      "name": "默认生成一个",
      "request": {},
      "expect": {
        "code": 0
      }
    },
    {
      "name": "指定长度与数量",
      "request": {
        "length": 24,
        "count": 3
      },
      "expect": {
        "code": 0
      }
    },
    {
      "name": "只含数字",
      "request": {
        "length": 8,
        "charsets": ["digit"]
      },
      "expect": {
        "code": 0
      }
    },
    {
      "name": "排除易混字符",
      "request": {
        "length": 32,
        "excludeAmbiguous": true
      },
      "expect": {
        "code": 0
      }
    },
    {
      "name": "长度越界",
      "request": {
        "length": 2
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    },
    {
      "name": "数量越界",
      "request": {
        "count": 1000
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    },
    {
      "name": "未知字符集",
      "request": {
        "charsets": ["emoji"]
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    }
  ]
}
