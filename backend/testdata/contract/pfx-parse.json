{
  "slug": "pfx-parse",
  "description": "PKCS#12 解析的契约测试数据。",
  "cases": [
    {
      "name": "解析容器",
      "request": {
        "container": {
          "data": "",
          "format": "der"
        },
        "passphrase": "test-pass"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "hasPrivateKey": true,
          "caCount": 1
        }
      }
    },
    {
      "name": "口令错误",
      "request": {
        "container": {
          "data": "",
          "format": "der"
        },
        "passphrase": "wrong-pass"
      },
      "expect": {
        "code": 400,
        "errorCode": "PASSPHRASE_INCORRECT"
      }
    }
  ]
