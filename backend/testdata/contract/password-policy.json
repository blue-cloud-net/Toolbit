{
  "slug": "password-policy",
  "description": "口令策略检查的契约测试数据。",
  "cases": [
    {
      "name": "满足中等强度",
      "request": {
        "password": "Zx7#quietRiver9",
        "preset": "medium"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "compliant": true
        }
      }
    },
    {
      "name": "不满足严格强度",
      "request": {
        "password": "abc",
        "preset": "strict"
      },
      "expect": {
        "code": 0,
        "dataContains": {
          "compliant": false
        }
      }
    },
    {
      "name": "不支持的预设",
      "request": {
        "password": "abc",
        "preset": "extreme"
      },
      "expect": {
        "code": 400,
        "errorCode": "INVALID_FIELD"
      }
    }
  ]
}
