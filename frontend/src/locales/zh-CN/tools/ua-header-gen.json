{
  "name": "UA 头生成",
  "description": "以 User-Agent 为核心，按平台与版本生成一组客户端请求头，可追加自定义请求头。",
  "category": "网络",
  "actions": {
    "run": "生成"
  },
  "fields": {
    "platform": "平台",
    "version": "版本号",
    "os": "操作系统",
    "acceptLanguage": "Accept-Language",
    "referer": "Referer",
    "customHeaders": "自定义请求头"
  },
  "options": {
    "platform": {
      "chrome": "Chrome 桌面版",
      "firefox": "Firefox 桌面版",
      "safari": "Safari 桌面版",
      "edge": "Edge 桌面版",
      "android": "Android Chrome",
      "ios": "iOS Safari",
      "curl": "curl"
    }
  },
  "results": {
    "headers": "请求头",
    "userAgent": "User-Agent",
    "headerName": "请求头名称",
    "headerValue": "请求头值"
  },
  "examples": [
    {
      "label": "Chrome 桌面版",
      "value": "{\"platform\":\"chrome\",\"version\":\"120.0.0.0\"}"
    },
    {
      "label": "Android Chrome",
      "value": "{\"platform\":\"android\",\"version\":\"131.0.0.0\"}"
    },
    {
      "label": "curl",
      "value": "{\"platform\":\"curl\",\"version\":\"8.9.1\"}"
    }
  ],
  "hints": {
    "platform": "首版只支持**内置**的常见平台与自定义填写，**不**引入任何在线 UA 查询。",
    "customHeaders": "每行一条，格式为 `名称: 值`。"
  },
  "faq": [
    {
      "q": "生成的请求头能绕过风控吗？",
      "a": "不能。它只是常见请求头的模板，用于调试与兼容性测试。"
    },
    {
      "q": "版本号与操作系统可以留空吗？",
      "a": "可以。留空时使用该平台的内置默认值；只有需要精确到某个版本时才填写。"
    },
    {
      "q": "自定义请求头为什么按字典序排列？",
      "a": "这样同一组自定义请求头每次生成的顺序都一致，便于比对与复制。"
    }
  ]
}
