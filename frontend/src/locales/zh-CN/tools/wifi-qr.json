{
  "name": "访客 WiFi 二维码",
  "description": "生成访客 WiFi 的连接二维码，手机扫码即可入网。",
  "category": "数据",
  "actions": {
    "run": "生成"
  },
  "fields": {
    "ssid": "网络名称",
    "password": "网络密码",
    "security": "加密方式",
    "hidden": "隐藏网络",
    "size": "图片边长"
  },
  "options": {
    "security": {
      "WPA": "WPA / WPA2 / WPA3",
      "WEP": "WEP",
      "nopass": "无密码"
    }
  },
  "results": {
    "payload": "二维码内容",
    "png": "PNG 图片",
    "svg": "SVG 图片",
    "size": "图片边长"
  },
  "examples": [
    {
      "label": "生成 WPA 二维码",
      "value": "{\"ssid\":\"Guest-Network\",\"password\":\"guest-password\",\"security\":\"WPA\",\"size\":256}"
    },
    {
      "label": "生成开放网络二维码",
      "value": "{\"ssid\":\"Open\",\"password\":\"\",\"security\":\"nopass\",\"size\":256}"
    }
  ],
  "hints": {
    "ssid": "二维码内容遵循 WIFI: 约定格式，各平台扫码后可直接连接。",
    "output": "密码会出现在二维码内容里，请只把二维码分享给访客。"
  },
  "faq": [
    {
      "q": "二维码能离线生成吗？",
      "a": "能，全部在服务端生成，不联网。"
    },
    {
      "q": "iOS 和 Android 都能扫吗？",
      "a": "都能。系统相机与微信等常用扫码工具都识别 WIFI: 格式。"
    }
  ]
}
