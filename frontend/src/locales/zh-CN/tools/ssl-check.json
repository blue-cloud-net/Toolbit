  "category": "网络",
  "actions": {
    "probe": "开始检测"
  },
  "fields": {
    "host": "主机",
    "port": "端口",
    "sni": "SNI",
    "depth": "链深度上限",
    "versions": "协议版本",
    "ciphers": "密码套件",
    "timeoutMs": "超时（毫秒）"
  },
  "options": {},
  "views": {
    "summary": "摘要",
    "chain": "证书链",
    "pem": "证书 PEM"
  },
  "results": {
    "output": "检测结果",
    "progress": "探测进度",
    "chain": "证书链",
    "grade": "安全评级 {grade}",
    "checkPass": "通过",
    "checkFail": "未通过",
    "endpoint": "端点",
    "address": "解析地址",
    "version": "协议版本",
    "cipher": "密码套件",
    "chainValid": "证书链有效",
    "verified": "已通过验证",
    "implicitTrust": "系统信任",
    "ocspStapled": "OCSP 装订",
    "certCount": "证书张数",
    "chainErrors": "链错误",
    "certIndex": "#",
    "certSubject": "主题",
    "certIssuer": "签发者",
    "certValidity": "有效期",
    "noCerts": "没有取到证书"
  },
  "examples": [
    {
      "label": "检测公共站点",
      "value": "example.com:443"
    }
  ],
  "hints": {
    "sni": "留空时用主机名做 SNI。",
    "versions": "留空表示使用默认版本范围（TLS 1.2 起）。",
    "ciphers": "TLS 1.3 的密码套件无法通过配置裁剪。"
  },
  "faq": [
    {
      "q": "为什么显示「验证未完成」？",
      "a": "本地信任库不可用时只能判断链内是否自洽，此时 `verified` 为 false 并给出警告。"
    },
    {
      "q": "目标是内网地址会怎样？",
      "a": "出网防护会拦截私有、环回、链路本地地址，返回 `SSRF_BLOCKED`。"
    },
    {
      "q": "同一时间能开多条连接吗？",
      "a": "不能。同一来源 IP 同时只允许 1 条流式连接。"
    }
  ]
}
