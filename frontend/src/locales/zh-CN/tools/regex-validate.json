{
  "name": "正则表达式校验",
  "description": "只校验正则表达式的语法，输出是否合法、错误位置与改进建议。",
  "category": "文本",
  "actions": {
    "run": "校验"
  },
  "fields": {
    "pattern": "正则表达式",
    "flags": "标志"
  },
  "options": {
    "flags": {
      "i": "忽略大小写",
      "m": "多行模式",
      "s": "匹配换行",
      "x": "忽略空白"
    }
  },
  "results": {
    "valid": "语法合法",
    "invalid": "语法错误",
    "dialect": "正则方言",
    "error": "错误信息",
    "position": "错误位置",
    "captureGroups": "捕获组数",
    "suggestions": "改进建议"
  },
  "examples": [
    {
      "label": "校验手机号表达式",
      "value": "{\"pattern\":\"^1[3-9]\\\\d{9}$\"}"
    },
    {
      "label": "校验有语法错误的表达式",
      "value": "{\"pattern\":\"([a-z\"}"
    }
  ],
  "hints": {
    "pattern": "本工具**只校验不匹配**：不接收待匹配文本，因此不存在超时的可能。",
    "output": "表达式合法时给出捕获组数量与改进建议；不合法时给出错误位置（第几行第几列）。"
  },
  "faq": [
    {
      "q": "支持哪些正则方言？",
      "a": "统一使用 RE2 方言（Go 正则），不支持回溯引用与递归等特性。"
    },
    {
      "q": "和正则测试工具有什么区别？",
      "a": "正则测试会实际匹配文本并给出全部命中；本工具只判断表达式本身是否合法。"
    }
  ]
}
