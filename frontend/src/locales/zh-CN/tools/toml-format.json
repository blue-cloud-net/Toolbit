      "format": "美化（重新排版）",
      "minify": "压缩（去掉空行）",
      "validate": "校验（只检查语法）"
    }
  },
  "results": {
    "output": "结果",
    "outputHint": "结果可直接复制。",
    "validity": "合法性",
    "valid": "合法",
    "invalid": "非法",
    "position": "错误位置",
    "reason": "错误原因",
