{
  "name": "速查表查询",
  "description": "查询端口号、Linux 退出码与时间戳格式的速查表。",
  "category": "系统",
  "actions": {
    "run": "查询"
  },
  "fields": {
    "kind": "速查表类别",
    "key": "查询内容"
  },
  "options": {
    "kind": {
      "port": "端口号",
      "exitcode": "退出码",
      "timestamp": "时间戳格式"
    }
  },
  "results": {
    "matched": "已命中",
    "notMatched": "未命中",
    "entry": "条目",
    "candidates": "候选",
    "dataVersion": "数据集版本"
  },
  "examples": [
    {
      "label": "查询 443 端口",
      "value": "{\"kind\":\"port\",\"key\":\"443\"}"
    },
    {
      "label": "检索退出码",
      "value": "{\"kind\":\"exitcode\",\"key\":\"错误\"}"
    }
  ],
  "hints": {
    "key": "端口可写数字（443）或名称（https）；退出码写数字；时间戳写格式名（unix-ms）。",
    "output": "数据来自**内置快照**，不联网也不读取系统服务列表。"
  },
  "faq": [
    {
      "q": "查不到会报错吗？",
      "a": "不会。精确查不到时会给出模糊匹配的候选列表。"
    },
    {
      "q": "端口号是权威来源吗？",
      "a": "是常见端口的快照，具体服务可能另作约定，请以实际部署为准。"
    }
  ]
}
