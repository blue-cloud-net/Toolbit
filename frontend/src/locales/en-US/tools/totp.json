  "faq": [
    {
      "q": "Is it compatible with common authenticator apps?",
      "a": "Yes. With standard parameters the result matches mainstream authenticators."
    },
    {
      "q": "Why is SHA1 the default?",
      "a": "SHA1 has the widest compatibility; choose SHA256 or SHA512 where stronger security matters."
    }
