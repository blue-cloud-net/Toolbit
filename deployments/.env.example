# ============================================================================
#  Toolbit — 部署环境变量模板
# ----------------------------------------------------------------------------
#  用法：
#      cp deployments/.env.example deployments/.env
#      按需修改后执行 make docker-up
#
#  compose 会自动读取**同目录**下的 .env；全部变量都有默认值，
#  因此不建 .env 也能起服务（默认值见 docs/deploy.md §3）。
#  本文件**不含**任何真实密钥：本项目无账号体系，只需要一个可选的统计 Token。
# ============================================================================

# ---- 镜像与版本 ----
# 每次发版递增标签，回滚时把 TAG 改回旧值再 up 即可
TAG=local
# 版本信息（注入 buildinfo，/api/v1/meta 会回显）；由 make docker-up 自动填充时可留空
COMMIT=unknown
BUILD_TIME=unknown

# ---- 对外端口与时区 ----
# TLS 由宿主机反向代理 / CDN 终止，本服务只监听明文 HTTP
HTTP_PORT=30234
TZ=Asia/Shanghai

# ---- 日志 ----
# debug / info / warn / error
TOOLBIT_LOG_LEVEL=info
# json（容器默认，便于采集）/ text（本地排错）
TOOLBIT_LOG_FORMAT=json

# ---- 反向代理 ----
# ⚠️ 只有在反代**确实覆写** X-Forwarded-For 时才能开；否则限流可被轻易绕过
TOOLBIT_TRUST_PROXY=false
# 逗号分隔的 Origin 白名单；留空表示不启用额外白名单
TOOLBIT_ALLOWED_ORIGINS=

# ---- 功能开关 ----
# 内部端点（/internal/*）默认关闭，禁止对公网暴露
TOOLBIT_ENABLE_INTERNAL_ENDPOINTS=false
TOOLBIT_RATE_LIMIT_ENABLED=true
TOOLBIT_STATS_ENABLED=true
# 出网工具总开关（DNS / HTTP 探测 / 证书链在线获取等）
TOOLBIT_NETWORK_ENABLED=true
# 额外允许出网的主机白名单（逗号分隔），用于放行被 SSRF 规则拦下的目标
TOOLBIT_NETWORK_ALLOWLIST=

# ---- 限额与超时 ----
# 全局兜底超时
TOOLBIT_REQUEST_TIMEOUT=30s
# 全局兜底请求体上限（字节，默认 100 MB）
TOOLBIT_MAX_BODY_BYTES=104857600
# 优雅退出等待时长（必须小于 compose 的 stop_grace_period）
TOOLBIT_SHUTDOWN_TIMEOUT=15s
# 容器内存上限
MEMORY_LIMIT=1g

# ---- 统计 ----
# 统计详情端点（/api/v1/stats/overview）的 Token；留空则端点返回 404
# 生成方式：openssl rand -base64 24
TOOLBIT_STATS_TOKEN=
